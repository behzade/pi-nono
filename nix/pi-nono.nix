{
  importNpmLock,
  lib,
  nodejs,
  nono,
  stdenvNoCC,
}:

let
  source = ../extensions/sandbox;
  nodeModules = importNpmLock.buildNodeModules {
    npmRoot = source;
    inherit nodejs;
  };
in
stdenvNoCC.mkDerivation {
  pname = "pi-nono";
  version = "3.0.0";

  src = source;

  installPhase = ''
    runHook preInstall
    mkdir -p $out
    for sourceFile in *.ts; do
      case "$sourceFile" in
        *.test.ts | test-setup.ts) continue ;;
      esac
      cp "$sourceFile" "$out/"
    done
    cp package.json package-lock.json $out/
    cp -R ${nodeModules}/node_modules "$out/"
    chmod -R u+w "$out/node_modules"
    cat > $out/fixed-executables.ts <<'EOF'
    /** Fixed nono Nix-store executable generated by nix/pi-nono.nix. */
    export const FIXED_NONO_PATH: string | null = "${nono}/bin/nono";
    EOF
    runHook postInstall
  '';

  meta = {
    description = "Pi sandbox policy adapter backed by nono";
    license = lib.licenses.mit;
    platforms = lib.platforms.darwin ++ lib.platforms.linux;
  };
}
